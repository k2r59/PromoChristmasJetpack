{
  "name": "noel-shift",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && node scripts/build-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.js",
    "build:client": "vite build",
    "db:generate": "drizzle-kit generate",
    "deploy": "npm run build && wrangler d1 migrations apply DB --remote && wrangler deploy",
    "dev:worker": "npm run build && wrangler d1 migrations apply DB --local && wrangler dev",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "drizzle-orm": "^0.45.4",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "sharp": "^0.34.0",
    "vite": "^7.1.0",
    "wrangler": "^4.154.0"
  }
}
